{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/concierge.js",
      "destination": "/site/concierge.js"
    },
    {
      "source": "/concierge.css",
      "destination": "/site/concierge.css"
    },
    {
      "source": "/products.json",
      "destination": "/site/products.json"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/site/assets/$1"
    },
    {
      "source": "/reference_screens/(.*)",
      "destination": "/site/reference_screens/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/site/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
