# Marcely Semijoias - Exemplo de Configuracao de Ambiente
PORT=3000
NODE_ENV=production

# Vercel AI Gateway Configuration
AI_GATEWAY_API_KEY=sua_chave_do_vercel_ai_gateway_aqui
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Site & CORS Settings
SITE_URL=https://marcely-semijoias.vercel.app
